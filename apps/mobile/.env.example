# Configuração pública do app (embutida no bundle: nunca coloque segredos aqui).
# Copie para .env. Em desenvolvimento, sem estas variáveis o app usa os valores abaixo.
# Emulador/celular com USB: adb reverse tcp:8080 tcp:8080 && adb reverse tcp:8180 tcp:8180
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_AUTH_ISSUER=http://localhost:8180/realms/bruzfin
EXPO_PUBLIC_AUTH_CLIENT_ID=bruzfin-mobile
