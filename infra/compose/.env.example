# Copie para .env (que não é versionado) e troque as senhas fora da máquina local.
#   cp infra/compose/.env.example infra/compose/.env
# Os valores abaixo só servem para desenvolvimento local.

# PostgreSQL: superusuário (só para administração) e usuários da API e do Keycloak.
POSTGRES_ADMIN_PASSWORD=postgres-local
BRUZFIN_DB_PASSWORD=bruzfin-local
KEYCLOAK_DB_PASSWORD=keycloak-local

# Valkey
VALKEY_PASSWORD=valkey-local

# Kafka (KRaft): ID do cluster, gerado com `kafka-storage.sh random-uuid`.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# Keycloak: administrador inicial do console (http://localhost:8180).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local
