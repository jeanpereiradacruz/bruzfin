{
  "name": "@bruzfin/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente HTTP da API do BruzFin, gerado pelo orval a partir do contrato OpenAPI",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@bruzfin/config": "workspace:*",
    "orval": "8.43.0",
    "typescript": "~7.0.2",
    "vitest": "5.1.0"
  }
}
